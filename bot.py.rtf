import feedparser
import google.generativeai as genai
import requests
import os
import time

# 1. CONFIGURATION
RSS_FEEDS = [
    "https://technologyreview.com",  # MIT Tech Review
    "https://openai.com",         # OpenAI Blog
    "https://google.com", # Google News (Last 24h)
    "https://huggingface.co"     # Hugging Face (New Models)
]

# 2. FETCH NEWS
def get_news():
    articles = []
    for url in RSS_FEEDS:
        feed = feedparser.parse(url)
        for entry in feed.entries[:5]: # Get top 5 from each source
            articles.append(f"- {entry.title} ({entry.link})")
    return "\n".join(articles)

# 3. ANALYZE WITH AI
def summarize_news(raw_news):
    genai.configure(api_key=os.environ["GEMINI_API_KEY"])
    model = genai.GenerativeModel('gemini-2.5-flash') # Using the fast, free model
    
    prompt = f"""
    You are an expert AI Tech Journalist. 
    Here is a list of raw news headlines and links from the last 24 hours:
    
    {raw_news}
    
    Task:
    1. Select the TOP 5 most critical stories related to AI advancement, new tools, or major ethical shifts.
    2. Rewrite them into a daily digest format.
    3. For each story, write a 1-sentence summary and include the link.
    4. Start with a "🔥 Daily Highlight" for the most important story.
    5. Keep it concise and professional. 
    """
    
    response = model.generate_content(prompt)
    return response.text

# 4. SEND TO DISCORD
def send_discord(content):
    webhook_url = os.environ["DISCORD_WEBHOOK_URL"]
    data = {
        "username": "AI Daily Digest",
        "content": content[:2000] # Discord has a text limit
    }
    requests.post(webhook_url, json=data)

# MAIN EXECUTION
if __name__ == "__main__":
    try:
        print("Fetching news...")
        raw_news = get_news()
        
        print("Analyzing with AI...")
        digest = summarize_news(raw_news)
        
        print("Sending to Discord...")
        send_discord(digest)
        print("Done!")
    except Exception as e:
        print(f"Error: {e}")
